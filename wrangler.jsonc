// Cloudflare Workers deployment (static assets + the suggestion handler in worker/).
// The destination address for suggestions is a secret: set SUGGEST_TO in the dashboard
// (Workers > intelligent-payroll > Settings > Variables and Secrets), never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intelligent-payroll",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "SUGGEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
