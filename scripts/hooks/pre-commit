#!/bin/sh
# Blocks a commit if the data is invalid, a scratch file (PDF, archive, file over 1 MB) is tracked,
# or the generated pages are stale. Install with: sh scripts/hooks/install.sh

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping checks (install Node 18+ to enable them)"
  exit 0
fi

if ! node scripts/validate.mjs; then
  echo ""
  echo "pre-commit: commit blocked. Fix the problems above (unstage stray files with: git rm --cached <file>)."
  exit 1
fi

if ! node scripts/build-pages.mjs --check; then
  echo ""
  echo "pre-commit: commit blocked. Run: node scripts/build-pages.mjs  then stage the regenerated files."
  exit 1
fi

if ! node scripts/test-worker.mjs >/dev/null; then
  node scripts/test-worker.mjs
  echo ""
  echo "pre-commit: commit blocked. The suggestion handler tests (scripts/test-worker.mjs) failed."
  exit 1
fi

if ! node scripts/test-site.mjs >/dev/null; then
  node scripts/test-site.mjs
  echo ""
  echo "pre-commit: commit blocked. The site regression tests (scripts/test-site.mjs) failed."
  exit 1
fi

if ! node scripts/test-filters.mjs >/dev/null; then
  node scripts/test-filters.mjs
  echo ""
  echo "pre-commit: commit blocked. The filter/CSV tests (scripts/test-filters.mjs) failed."
  exit 1
fi

if ! node scripts/test-app.mjs >/dev/null; then
  node scripts/test-app.mjs
  echo ""
  echo "pre-commit: commit blocked. The app wiring tests (scripts/test-app.mjs) failed."
  exit 1
fi

if ! node scripts/test-print.mjs >/dev/null; then
  node scripts/test-print.mjs
  echo ""
  echo "pre-commit: commit blocked. The print stylesheet tests (scripts/test-print.mjs) failed."
  exit 1
fi
